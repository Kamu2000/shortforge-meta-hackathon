# Spatial Director — environment variables (EXAMPLE — no real keys here)
#
# Copy to a local, git-ignored file (e.g. .env) and fill in your own
# keys, or export the variables in your shell. Never commit real keys.

# Meta Model API key — used for SAM 3.1, Muse Spark 1.3,
# Muse Voice Transcribe, Muse Wonder and Muse Image.
# Get one from the Meta Model API developer console (dev.meta.ai):
# create an account / project, then create an API key for the
# Muse / SAM model endpoints.
SPATIAL_DIRECTOR_META_API_KEY=

# Baseten API key — used for Muse Spark Open (open weights), the
# candidate-sweep scoring stage. Get one from your Baseten account
# (app.baseten.co -> Settings -> API Keys). The hackathon partner
# grant covers Muse Spark Open usage during the event window.
SPATIAL_DIRECTOR_BASETEN_API_KEY=

# Optional: enable the context-graphics layer (context cards,
# Muse Image stills, procedural SFX, F8 verification).
# Unset / 0 = graphics layer off; the pipeline then produces the
# F1-F7 + F9 verified Shorts only.
GRAPHICS_LAYER=
