# Secrets and local config — never commit credentials
.env
.env.*
!.env.example
*.key
*.pem
secrets/
local_config.json

# Python
__pycache__/
*.pyc
.venv/
venv/

# Generated media and caches
*.mp4
*.mov
*.wav
*.mp3

# Bundled re-verification evidence set — the ONE run-artifact set
# shipped on purpose (README, "Keyless verification"). Scoped
# exception for this path only; the global media ignores above
# still apply everywhere else.
!/evidence/qm6-fix6-short1/*.mp4
!/evidence/qm6-fix6-short1/*.wav
cache/
tmp/
out/

# Editor / OS
.DS_Store
.idea/
.vscode/
